 <Window x:Class="HeatingPipeV5.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HeatingPipeV5"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: системы отопления -->
        <StackPanel Grid.Column="0" Margin="20">
            <TextBlock Text="Выберите систему отопления (только подачу)" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>

            <TextBox x:Name="SearchSystemTextBox" Width="400" Margin="5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox x:Name="SystemsListBox"
             Width="400"
             Height="200"
             ItemsSource="{Binding FilteredSystemNumbersList}"
             SelectionMode="Extended"
             Background="#D9D9D9"
             BorderBrush="#B0B0B0"
             BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SystemName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Начать" Command="{Binding StartCommand}" Margin="0,10,0,0" Width="400" Background="#5B9BD5" Foreground="White" Padding="10"/>
           
            <Button Content="Выбрать отдельные ветви" Command="{Binding StartPartial}" Margin="0,10,0,0" Width="400" Background="#5B9BD5" Foreground="White" Padding="10"/>

            <Label Content="{Binding SelectedSystems}" Margin="10" FontWeight="Bold"/>
        </StackPanel>

        <!-- Правая колонка: связанные модели -->
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Text="Выберите связанную модель" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>

            <TextBox x:Name="SearchModelTextBox" Width="400" Margin="5" Text="{Binding SearchModelText, UpdateSourceTrigger=PropertyChanged}" />

            <ListBox x:Name="LinkedModelsListBox"
             Width="400"
             Height="200"
             ItemsSource="{Binding FilteredLinkedModelsList}"
             SelectionMode="Extended"
             Background="#D9D9D9"
             BorderBrush="#B0B0B0"
             BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ModelName}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Перенести пространства" Command="{Binding CollectMepRoomsCommand}" Margin="0,10,0,0" Width="400" Background="#5B9BD5" Foreground="White" Padding="10"/>
        </StackPanel>
    </Grid>


</Window>